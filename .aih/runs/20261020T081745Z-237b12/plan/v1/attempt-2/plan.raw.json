{
  "criteria": [
    {
      "intent": "INTENT1",
      "key": "C_ENUM",
      "kind": "behavior",
      "text": "DagSchedulingState has exactly the members ACTIVE='active', DRAINING='draining', PAUSED='paused'."
    },
    {
      "intent": "INTENT2",
      "key": "C_MODEL",
      "kind": "behavior",
      "text": "DagModel.is_draining defaults to False; scheduling_state returns paused/draining/active from the flags; set_scheduling_state sets both flags consistently; the database rejects is_paused and is_draining both true."
    },
    {
      "intent": "INTENT3",
      "key": "C_MIGRATION",
      "kind": "other",
      "text": "New 3.4.0 migration revises f8c2a1d94e03, adds non-null is_draining (server default false) with index and check constraint, and index on backfill(dag_id, completed_at); migrations-ref.rst, DB head map and ERD are updated; models match the migration."
    },
    {
      "intent": "INTENT4",
      "key": "C_NO_RUNS",
      "kind": "behavior",
      "text": "dags_needing_dagruns excludes draining Dags; an asset event for a draining Dag (direct, alias, name or URI reference) is recorded but creates no AssetDagRunQueue row; pending partitioned-asset events of a draining Dag produce no Dag run."
    },
    {
      "intent": "INTENT5",
      "key": "C_INFLIGHT",
      "kind": "behavior",
      "text": "Task instances of queued/running runs of a draining Dag are still scheduled and queued, its unfinished runs are still examined, and a manual trigger or backfill can still create runs."
    },
    {
      "intent": "INTENT6",
      "key": "C_FINALIZE",
      "kind": "behavior",
      "text": "_finalize_draining_dags moves a draining Dag with no queued/running run and no backfill lacking Dag runs to paused and writes a Log with event drain_completed and owner scheduler; it leaves Dags with an unfinished run or an uninitialised backfill draining; Dags are processed in dag_id order with limit and row locks; the step is registered every 5 seconds in the scheduler loop."
    },
    {
      "intent": "INTENT7",
      "key": "C_AUTOPAUSE",
      "kind": "behavior",
      "text": "Auto-pause after max consecutive failed runs sets is_paused True and is_draining False for a draining Dag."
    },
    {
      "intent": "INTENT8",
      "key": "C_API_RESP",
      "kind": "behavior",
      "text": "DAGResponse and DAGDetailsResponse expose scheduling_state, default active, reflecting the model."
    },
    {
      "intent": "INTENT8",
      "key": "C_API_PATCH",
      "kind": "behavior",
      "text": "PATCH /dags/{dag_id} and PATCH /dags accept exactly one non-null of is_paused or scheduling_state (explicit null for the other accepted); both present, both null, or only null returns 422; update_mask naming is_paused or scheduling_state must match the body field else 422; response and bulk update set both flags for every matched Dag; is_paused true pauses and false activates, both clearing draining."
    },
    {
      "intent": "INTENT9",
      "key": "C_UI",
      "kind": "behavior",
      "text": "/ui/dags supports scheduling_state filter (active, draining, paused); paused=false still includes draining Dags; every Dag has has_unfinished_runs true iff a queued or running run exists regardless of dag_runs_limit; dashboard active_dag_count excludes draining Dags."
    },
    {
      "intent": "INTENT10",
      "key": "C_CLI",
      "kind": "behavior",
      "text": "dags pause sets paused and dags unpause sets active, both clearing draining; a draining Dag is matched as needing change by both commands; dags details output includes scheduling_state."
    },
    {
      "intent": "INTENT11",
      "key": "C_DOCS",
      "kind": "other",
      "text": "core-concepts/dags.rst and faq.rst describe draining; an airflow-core newsfragment announces it (written 'Dag'); no UI files changed."
    },
    {
      "intent": "INTENT12",
      "key": "C_TESTS",
      "kind": "other",
      "text": "Tests added in model, scheduler, asset manager, public API, UI API, dashboard and CLI suites; existing tests asserting exact response shapes are updated."
    }
  ],
