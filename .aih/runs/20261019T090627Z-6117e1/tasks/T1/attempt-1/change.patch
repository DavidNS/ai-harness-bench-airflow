+class DagSchedulingState(str, Enum):
+    """
+    Scheduling state of a Dag.
+
+    ``DRAINING`` is transient: no new scheduler-created runs are started while the
+    work in flight finishes, and the Dag then becomes ``PAUSED`` on its own.
+    """
+
+    ACTIVE = "active"
+    DRAINING = "draining"
+    PAUSED = "paused"
+
+    def __str__(self) -> str:
+        return self.value
+
+
 class State:
